# ---------------------------------------------------------------------------
# Aurena Nails environment template
# Copy to .env for local development and replace every empty secret/credential.
# Never use an example connection string or a website URL as AUTH_SECRET.
# ---------------------------------------------------------------------------

# Neon PostgreSQL (pooled connection URL), used by Prisma 7 + @prisma/adapter-pg.
# Example shape only: postgresql://USER:PASSWORD@HOST-pooler.REGION.neon.tech/DB?sslmode=require
DATABASE_URL=""

# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Must be a random 32-byte (or stronger) secret, not a URL or database credential.
AUTH_SECRET=""

# Public origin used for metadata, sitemap and outbound links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
STUDIO_TIMEZONE="Asia/Kolkata"

# Set true only when the app is served inside a sandboxed iframe preview.
# Never enable in production.
# ALLOW_FRAME_EMBEDDING="true"

# Cloudinary is required for uploads in production. Without credentials, local
# development and preview builds store files under ./public/uploads instead.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="aurena-nails"

# Optional SMTP for password resets and transactional notifications.
# In development only, reset links are printed to the server log when SMTP is
# not configured. Production logs never include reset tokens.
EMAIL_SERVER=""
EMAIL_USERNAME=""
EMAIL_PASSWORD=""
EMAIL_FROM="Aurena Nails <hello@aurenanails.com>"
EMAIL_PORT="587"
EMAIL_SECURE="false"

# Required by `npm run db:seed` to create the initial administrator.
# Use a unique, strong password and rotate it after provisioning if needed.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Demo catalogue, customers and appointments are included by default outside
# production. Set these explicitly only when you want demo fixtures in a
# production database; never use a shared or predictable demo password there.
# SEED_DEMO_DATA="true"
# SEED_DEMO_PASSWORD=""
