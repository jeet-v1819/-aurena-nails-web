// ---------------------------------------------------------------------------
// Aurena Nails — Prisma schema
// ---------------------------------------------------------------------------
// Database : Neon PostgreSQL (serverless Postgres)
// ORM      : Prisma 7
//
// Neon setup
//   1. Create a project at https://console.neon.tech
//   2. Copy the pooled connection string (`...-pooler...?sslmode=require`)
//   3. Put it in `.env` as DATABASE_URL="postgresql://..."
//   4. npm run db:deploy && npm run db:seed
//
// NOTE (Prisma 7): connection URLs are no longer allowed inside
// `datasource` blocks. The CLI reads it from `prisma.config.ts` and the runtime
// Prisma Client receives it through the `@prisma/adapter-pg` driver adapter in
// `src/lib/db/prisma.ts` — both read the SAME `DATABASE_URL` environment
// variable, exactly as required.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Access level. Admins manage the studio; customers book appointments.
enum Role {
  ADMIN
  CUSTOMER
}

/// A single `Category` table is shared by services, gallery images and videos.
/// `type` discriminates which area a category belongs to (SERVICE | GALLERY |
/// VIDEO), which keeps one CRUD screen in the admin panel instead of three
/// identical tables.
enum CategoryType {
  SERVICE
  GALLERY
  VIDEO
}

/// Appointment lifecycle.
///   PENDING   -> requested by the customer, waiting for the studio
///   CONFIRMED -> accepted by the studio, the slot is reserved
///   COMPLETED -> the visit happened (unlocks reviews)
///   CANCELLED -> cancelled by the customer, the admin, or the studio
///   REJECTED  -> the studio could not accept the request
enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  REJECTED
}

/// Broad grouping used by the notification centre icons.
enum NotificationType {
  ACCOUNT
  APPOINTMENT
  REVIEW
  MESSAGE
  SYSTEM
}

// ---------------------------------------------------------------------------
// Accounts
// ---------------------------------------------------------------------------

/// Studio customer OR admin. A customer can sign in with email *or* mobile.
model User {
  id           String    @id @default(cuid())
  firstName    String
  lastName     String
  email        String    @unique
  /// Required for customers. Stored normalised to E.164 (+91XXXXXXXXXX).
  mobile       String    @unique
  passwordHash String
  /// Incremented on password changes and account deactivation to revoke old JWTs.
  sessionVersion Int @default(0)
  /// Cloudinary URL + public id of the profile picture (optional).
  avatarUrl      String?
  avatarPublicId String?
  role         Role      @default(CUSTOMER)
  /// false = deactivated. Deactivated customers cannot sign in.
  isActive     Boolean   @default(true)
  deactivatedAt DateTime?
  lastLoginAt   DateTime?
  /// Soft delete: the row is kept so appointment history stays intact.
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  appointments         Appointment[]         @relation("CustomerAppointments")
  appointmentsHandled  Appointment[]         @relation("AppointmentHandledBy")
  appointmentEvents    AppointmentEvent[]
  reviews              Review[]
  wishlist             Wishlist?
  notifications        Notification[]
  passwordResetTokens  PasswordResetToken[]
  contactMessages      ContactMessage[]
  galleryImages        GalleryImage[]
  auditLogs            AuditLog[]

  @@index([role, isActive])
  @@index([isActive, deletedAt])
  @@index([createdAt])
  @@index([lastLoginAt])
}

/// Single-use password reset token. Only the SHA-256 hash of the token is
/// stored, so a database leak cannot be turned into an account takeover.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Catalogue of services, gallery and videos
// ---------------------------------------------------------------------------

/// Categories for services, gallery images and videos (see `CategoryType`).
model Category {
  id          String       @id @default(cuid())
  name        String
  slug        String
  type        CategoryType @default(SERVICE)
  description String?
  imageUrl    String?
  imagePublicId String?
  isActive    Boolean      @default(true)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  services      Service[]
  galleryImages GalleryImage[]
  videos        Video[]

  @@unique([type, slug])
  @@index([type, isActive])
  @@index([sortOrder])
}

/// A nail service offered by the studio (Gel Nails, Bridal Nails, …).
/// Prices are informational — Aurena Nails does not sell online.
model Service {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  shortDescription String
  description      String
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  /// Appointment length in minutes (drives the booking slot calculation).
  durationMinutes Int
  /// Informational pricing shown on the website.
  startingPrice Decimal? @db.Decimal(10, 2)
  regularPrice  Decimal? @db.Decimal(10, 2)
  promoPrice    Decimal? @db.Decimal(10, 2)
  currency      String   @default("INR")

  /// Facets used by the services filters.
  nailType String?
  style    String?
  occasion String?
  difficulty String?

  preparationInstructions String?
  afterCareInstructions   String?

  isActive    Boolean @default(true)
  isFeatured  Boolean @default(false)
  /// false = temporarily unavailable (shown greyed out, not bookable).
  isAvailable Boolean @default(true)
  sortOrder   Int     @default(0)
  /// Cached rating aggregates, recalculated whenever a review changes.
  ratingAverage Decimal @default(0) @db.Decimal(3, 2)
  ratingCount   Int     @default(0)
  viewCount     Int     @default(0)

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  images       ServiceImage[]
  videos       ServiceVideo[]
  appointments Appointment[]
  reviews      Review[]
  wishlistItems WishlistItem[]

  @@index([categoryId])
  @@index([isActive, isFeatured])
  @@index([isActive, sortOrder])
  @@index([startingPrice])
  @@index([deletedAt])
}

/// Extra image for a service (main image = the primary one / lowest sortOrder).
model ServiceImage {
  id          String  @id @default(cuid())
  serviceId   String
  service     Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  /// Cloudinary secure URL (or /uploads/... in local storage mode).
  url         String
  publicId    String?
  alt         String?
  fileType    String?
  fileSize    Int?
  width       Int?
  height      Int?
  isPrimary   Boolean @default(false)
  sortOrder   Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([serviceId, sortOrder])
}

/// Promotional video attached to a service.
model ServiceVideo {
  id          String  @id @default(cuid())
  serviceId   String
  service     Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  title       String
  url         String
  publicId    String?
  thumbnailUrl String?
  thumbnailPublicId String?
  durationSeconds Int?
  width       Int?
  height      Int?
  fileSize    Int?
  format      String?
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([serviceId, sortOrder])
}

/// Nail-art photo in the gallery.
model GalleryImage {
  id          String   @id @default(cuid())
  title       String
  description String?
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  url      String
  publicId String?
  alt      String?
  width    Int?
  height   Int?
  fileSize Int?
  format   String?

  /// Searchable / filterable tags (Postgres text array).
  tags     String[] @default([])
  style     String?
  occasion  String?
  /// The date the design was created / photographed.
  designDate DateTime? @db.Date

  isFeatured Boolean @default(false)
  isActive   Boolean @default(true)
  sortOrder  Int     @default(0)
  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wishlistItems WishlistItem[]

  @@index([categoryId, isActive])
  @@index([isActive, isFeatured])
  @@index([createdAt])
  @@index([deletedAt])
}

/// Nail-art video in the video gallery.
model Video {
  id          String   @id @default(cuid())
  title       String
  description String?
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  url               String
  publicId          String?
  thumbnailUrl      String?
  thumbnailPublicId String?
  durationSeconds   Int?
  width             Int?
  height            Int?
  fileSize          Int?
  format            String?

  tags     String[] @default([])
  isFeatured Boolean @default(false)
  isActive   Boolean @default(true)
  viewCount  Int     @default(0)
  publishedAt DateTime @default(now())

  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId, isActive])
  @@index([isActive, isFeatured])
  @@index([publishedAt])
  @@index([deletedAt])
}

// ---------------------------------------------------------------------------
// Appointments
// ---------------------------------------------------------------------------

/// A booked visit. The slot is stored as date + minutes-from-midnight so
/// availability maths never depends on the server timezone.
model Appointment {
  id        String   @id @default(cuid())
  /// Human friendly booking code shown to the customer (e.g. AUR-7K2QF4).
  reference String   @unique
  userId    String
  user      User     @relation("CustomerAppointments", fields: [userId], references: [id], onDelete: Cascade)
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  /// Calendar date of the visit.
  date DateTime @db.Date
  /// Minutes from midnight, studio local time (e.g. 600 = 10:00).
  startMinutes Int
  endMinutes   Int
  /// Length actually reserved (service duration, snapshotted at booking time).
  durationMinutes Int

  status AppointmentStatus @default(PENDING)
  customerNote String?
  adminNote    String?
  /// Informational price snapshot — no payment is taken online.
  quotedPrice  Decimal? @db.Decimal(10, 2)

  cancelledAt    DateTime?
  cancelledById  String?
  statusChangedAt DateTime @default(now())
  handledById    String?
  handledBy      User?    @relation("AppointmentHandledBy", fields: [handledById], references: [id], onDelete: SetNull)
  completedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events  AppointmentEvent[]
  reviews Review[]

  @@index([userId, date])
  @@index([serviceId, date])
  @@index([date, status])
  @@index([status])
  @@index([createdAt])
}

/// Audit trail of every appointment status change.
model AppointmentEvent {
  id            String   @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  status        AppointmentStatus
  note          String?
  actorId       String?
  actor         User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())

  @@index([appointmentId, createdAt])
}

// ---------------------------------------------------------------------------
// Wishlist (saved favourites — no cart, no checkout)
// ---------------------------------------------------------------------------

/// One wishlist per customer. Items point at a service or a gallery design.
model Wishlist {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items WishlistItem[]
}

/// A single saved favourite. Exactly one of `serviceId` / `galleryImageId`
/// is set (validated in the service layer).
model WishlistItem {
  id             String         @id @default(cuid())
  wishlistId     String
  wishlist       Wishlist       @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  serviceId      String?
  service        Service?       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  galleryImageId String?
  galleryImage   GalleryImage?  @relation(fields: [galleryImageId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())

  @@unique([wishlistId, serviceId])
  @@unique([wishlistId, galleryImageId])
  @@index([wishlistId])
}

// ---------------------------------------------------------------------------
// Reviews
// ---------------------------------------------------------------------------

/// Customer review of a service. Only allowed after a COMPLETED appointment.
model Review {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceId     String
  service       Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  rating  Int     @db.SmallInt
  comment String?
  /// false = hidden by an admin (kept for the audit trail, not shown publicly).
  isVisible Boolean @default(true)
  hiddenAt  DateTime?
  /// Admin moderation note (never overwrites the customer's words silently).
  adminNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, serviceId])
  @@index([serviceId, isVisible])
  @@index([rating])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Communication
// ---------------------------------------------------------------------------

/// Message submitted through the public contact form.
model ContactMessage {
  id      String  @id @default(cuid())
  name    String
  email   String
  mobile  String
  subject String
  message String

  isRead   Boolean   @default(false)
  readAt   DateTime?
  /// Set when a signed-in customer sends the message.
  userId   String?
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([isRead, createdAt])
  @@index([createdAt])
}

/// In-app notification for a customer (appointment updates, review replies, …).
model Notification {
  id      String           @id @default(cuid())
  userId  String
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type    NotificationType @default(SYSTEM)
  title   String
  message String
  /// Relative deep link, e.g. /appointments
  link    String?
  isRead  Boolean          @default(false)
  readAt  DateTime?
  createdAt DateTime       @default(now())

  @@index([userId, isRead, createdAt])
  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Website content & studio configuration
// ---------------------------------------------------------------------------

/// Key/value store for editable website copy, contact details, social links and
/// appointment rules. Keys are grouped by `section` so the admin panel can render
/// one form per area. Defaults live in `src/lib/content/defaults.ts`.
model WebsiteContent {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  section   String   @default("general")
  label     String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([section])
}

/// Opening hours. `dayOfWeek`: 0 = Sunday … 6 = Saturday.
model BusinessHours {
  id        String @id @default(cuid())
  dayOfWeek Int    @unique
  isOpen    Boolean @default(true)
  /// Minutes from midnight, studio local time.
  openMinutes  Int @default(600)  // 10:00
  closeMinutes Int @default(1140) // 19:00
  /// Optional lunch/break window — slots inside it are not offered.
  breakStartMinutes Int?
  breakEndMinutes   Int?
  /// Overrides the studio-wide slot interval for this day.
  slotIntervalMinutes Int?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Special closed dates (festivals, holidays). Bookings are blocked on these.
model Holiday {
  id          String   @id @default(cuid())
  name        String
  date        DateTime @db.Date @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date, isActive])
}

/// Admin action trail. Used e.g. to record moderating a customer review, which
/// must never silently rewrite customer-authored content.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  /// JSON string with the fields that changed (before/after).
  changes   String?  @db.Text
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}
