{
  "name": "aurena-nails",
  "version": "1.0.0",
  "private": true,
  "description": "Aurena Nails — luxury nail art & beauty studio website. Next.js App Router + TypeScript + Prisma + Neon PostgreSQL + Cloudinary.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prisma-generate.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/prisma-generate.mjs",
    "db:generate": "node scripts/prisma-generate.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "node scripts/db-deploy.mjs",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "node scripts/db-deploy.mjs --reset",
    "db:local:start": "node scripts/local-postgres.mjs start",
    "db:local:stop": "node scripts/local-postgres.mjs stop",
    "setup": "node scripts/prisma-generate.mjs && node scripts/db-deploy.mjs && tsx prisma/seed.ts",
    "verify:schema": "node scripts/verify-schema.mjs"
  },
  "dependencies": {
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "framer-motion": "^14.0.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.53.0",
    "next": "^16.4.0",
    "nodemailer": "^10.0.16",
    "pg": "^8.13.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.89.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@prisma/prisma-schema-wasm": "^7.10.0-4.0edf323efd1d98336f3f0a68684b56f689b900d3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.4.0",
    "prisma": "7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
}
