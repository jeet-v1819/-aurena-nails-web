# ---------------------------------------------------------------------------
# Aurena Nails — environment template
#
#   cp .env.example .env      then fill in the values below.
#
# Never commit the real `.env`: it is already listed in .gitignore.
# ---------------------------------------------------------------------------

# --- Database (Neon PostgreSQL) --------------------------------------------
# 1. Create a free project at https://console.neon.tech
# 2. Dashboard -> Connection string -> copy the POOLED string
# 3. Paste it below (keep the quotes)
#
# Neon pooled connection string looks like:
#   postgresql://neondb_owner:AbC123@ep-cool-name-123456-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
#
# Local development without Neon (starts a real PostgreSQL server in
# ./.local-postgres):  npm run db:local:start  and use the URL below.
DATABASE_URL="postgresql://aurena:aurena@localhost:5432/aurena_nails?schema=public"

# --- Authentication --------------------------------------------------------
# Signs the HTTP-only session cookie. REQUIRED.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-me-with-a-32-byte-random-base64-secret"

# Public origin of the site (used for password-reset links, sitemap, OG tags).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Preview / sandbox only ------------------------------------------------
# Set to "true" ONLY when the site is served inside a framed preview (a sandbox
# or an iframe host). It relaxes the clickjacking header so the preview renders.
# Leave unset in production: the strict X-Frame-Options: SAMEORIGIN stays on.
# ALLOW_FRAME_EMBEDDING="true"

# --- Media storage (Cloudinary) -------------------------------------------
# Dashboard -> https://console.cloudinary.com -> Settings -> API Keys
# When these are set, every upload goes to Cloudinary.
# When they are empty the app automatically falls back to LOCAL storage
# (files are written to ./public/uploads) so development always works.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Optional sub-folder inside your Cloudinary account.
CLOUDINARY_FOLDER="aurena-nails"

# --- Transactional email (password reset, appointment confirmations) -------
# Any SMTP provider works. With Gmail use an App Password, not your password.
# Leave EMAIL_SERVER empty in development: reset links are printed to the
# server console instead of being emailed.
EMAIL_SERVER=""
EMAIL_USERNAME=""
EMAIL_PASSWORD=""
EMAIL_FROM="Aurena Nails <hello@aurenanails.com>"
EMAIL_PORT="587"
EMAIL_SECURE="false"
