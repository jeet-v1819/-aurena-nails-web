# ---------------------------------------------------------------------------
# Multi-Vendor E-Commerce Platform — environment template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
#
#   cp .env.example .env      (macOS/Linux)
#   copy .env.example .env    (Windows)
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# LOCAL DEVELOPMENT (SQLite). The path is resolved relative to prisma/,
# so this creates prisma/dev.db. No database server required.
DATABASE_URL="file:./dev.db"

# PRODUCTION (PostgreSQL / Neon) — replace DATABASE_URL with something like:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public&sslmode=require"
# Neon example:
# DATABASE_URL="postgresql://user:pass@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Optional: force a specific Prisma driver adapter instead of auto-detecting
# from DATABASE_URL. One of: pg | better-sqlite3 | libsql
# DATABASE_ADAPTER=""

# --- NextAuth -------------------------------------------------------------
# REQUIRED in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="replace-me-with-a-32-byte-random-base64-secret"

# next-auth v4 resolves its callback origin like this:
#   1. NEXTAUTH_URL if set;
#   2. else the request's X-Forwarded-Host / Host, but ONLY when VERCEL or
#      AUTH_TRUST_HOST is set;
#   3. else nothing -> "[NEXTAUTH_URL]" warning and broken sign-in redirects.
# (There is no `trustHost` config option in v4 — that is Auth.js v5.)
#
# >>> LOCAL DEVELOPMENT: uncomment this, and do NOT set AUTH_TRUST_HOST. <<<
# Behind no proxy, x-forwarded-proto is absent, so trusting the host would
# derive https://localhost:3000 and the browser would refuse to connect.
NEXTAUTH_URL="http://localhost:3000"

# >>> NETLIFY / any reverse proxy / deploy previews: do the opposite. <<<
# Leave NEXTAUTH_URL unset and uncomment this, so the origin follows the real
# host (production URL and per-deploy preview URLs both work, nothing to pin):
# AUTH_TRUST_HOST="true"

# --- Optional: Google social login ----------------------------------------
# The credentials provider works without these. Google login is enabled ONLY
# when BOTH variables are set, so leaving them blank is safe.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# --- Demo data -------------------------------------------------------------
# The login page shows one-click buttons for the accounts created by
# `npm run db:seed` (admin@shop.test / seller@shop.test / customer@shop.test,
# password Password123!). They sign in through the real credentials provider, so
# they only work if the seed has been run. Set to "false" in production to hide
# the panel entirely.
# NEXT_PUBLIC_DEMO_ACCOUNTS="true"

# --- Commerce settings (all optional, sensible defaults are built in) ------
# SHIPPING_FEE="5.99"
# TAX_RATE="0.1"
# FREE_SHIPPING_THRESHOLD="0"
